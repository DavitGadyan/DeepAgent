# Copy to .env and adjust. Nothing here is a secret by default; .env is git-ignored anyway.
# This file is read by Docker Compose and, for the applier, by the shell: quote any value
# that contains spaces.

# --- Models -----------------------------------------------------------------------
# Where Ollama runs. Default: an Ollama on this machine. For the GPU box use its address,
# e.g. http://192.168.1.50:11434 (start Ollama there with OLLAMA_HOST=0.0.0.0).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Defaults per agent are in config/agents.toml (qwen3:14b). Each setting can be overridden
# for every chat agent (LEADSCOUT_*) or for one agent (<AGENT>_*, which wins).
# On a machine without a GPU, uncomment these (and `make models CHAT_MODEL=qwen2.5:7b`):
# LEADSCOUT_MODEL=qwen2.5:7b
# LEADSCOUT_NUM_CTX=4096
# LEADSCOUT_TIMEOUT_S=900          # CPU inference takes minutes per model call
# RESEARCHER_TIMEOUT_S=3600        # the whole research budget; it makes 4-8 model calls
# SCORER_MODEL=deepseek-r1:14b

# --- Your profile ---------------------------------------------------------------------
# The polishmycv repo. The scorer reads your CV text and portfolio catalogue from its docs/,
# the applier runs the skill there, and the API serves files from its output/.
POLISHMYCV_HOME=/Users/dyada/Desktop/Github/polishmycv
# Paths inside $POLISHMYCV_HOME/docs, if yours differ from these defaults:
# PROFILE_CV_RELPATH=cv/David_Gadyan_Resume.txt
# PROFILE_CATALOGUE_RELPATH=portfolio-catalogue.json

# --- Tracing (optional) ------------------------------------------------------------------
# Set both keys to send every model call to Langfuse: prompt, output, tokens, latency, cost.
# Langfuse Cloud: create a project at https://cloud.langfuse.com and copy its keys.
# Self-hosted: set LANGFUSE_BASE_URL to your server. For a Langfuse on this machine use
# http://host.docker.internal:<port> (`make applier` rewrites it to localhost for the host).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Sources ----------------------------------------------------------------------------
# LinkedIn / Indeed and other scraped sources. Against those sites' terms; off by default.
ENABLE_SCRAPED_SOURCES=false

# --- Web ----------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
POSTGRES_PASSWORD=leadscout

# --- Applier (host-side worker, `make applier`) ------------------------------------------
REDIS_URL=redis://localhost:6379/0
# CLAUDE_BIN=claude
# CHROME_BIN="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# APPLIER_CDP_PORT=9333
# Spending caps per Claude Code session, in USD (0 = no cap):
# APPLIER_TAILOR_BUDGET_USD=10
# APPLIER_FILL_BUDGET_USD=5
